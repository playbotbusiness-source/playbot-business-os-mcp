
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "playbot-business-os-mcp",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/oauth/*"]
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "4b175ec54a78436897073af972511788"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
